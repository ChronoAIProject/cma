[Desktop Entry]
Version=1.0
Type=Application
Name=Chromium Web Browser
Comment=Browse the web on your shared desktop
Exec=/usr/local/bin/cma-desktop-session --browser %U
Icon=chromium
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=chromium
