 void CGLRenderbuffer::unbind() {
+    if (m_shmBound) {
+        m_shmBound = false;
+        auto buffer = m_hlBuffer.lock();
+        RASSERT(buffer, "CMA SHM output disappeared during rendering");
+        const auto attrs = buffer->shm();
+        auto [pixels, format, length] = buffer->beginDataPtr(0);
+        RASSERT(pixels && attrs.stride == static_cast<int>(buffer->size.x) * 4 &&
+                    length >= static_cast<size_t>(attrs.stride) * static_cast<size_t>(buffer->size.y), "Invalid CMA SHM output");
+        GLint previous = 0, alignment = 0;
+        glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &previous);
+        glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, GLFB(m_framebuffer)->getFBID());
+        glPixelStorei(GL_PACK_ALIGNMENT, 4);
+        // Match the compositor's existing SHM screenshot channel layout. The
+        // render projection already uses output coordinates, so rows stay put.
+        glReadPixels(0, 0, buffer->size.x, buffer->size.y, GL_BGRA_EXT, GL_UNSIGNED_BYTE, pixels);
+        RASSERT(glGetError() == GL_NO_ERROR, "CMA SHM framebuffer readback failed");
+        glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, previous);
+        buffer->endDataPtr();
+    }
     GLFB(m_framebuffer)->unbind();
 }
