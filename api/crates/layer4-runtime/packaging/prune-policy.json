{
  "schema": "runtime-packaging-prune-v1",
  "remove": [
    "tmp",
    "var/tmp",
    "root/.npm",
    "usr/local/lib/node_modules/npm/docs",
    "usr/local/lib/node_modules/npm/man",
    "usr/local/share/doc/node"
  ],
  "library_roots": ["usr/local/lib/node_modules"],
  "development_directories": ["test", "tests", "__tests__", "example", "examples"]
}
