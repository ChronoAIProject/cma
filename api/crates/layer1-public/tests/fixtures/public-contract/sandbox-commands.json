          "sandbox_id": "sbx_route",
          "command": "pause",
          "expected_revision": 1,
          "admitted_at": "2026-09-15T00:00:00Z",
          "queue_deadline": "2026-09-15T00:05:00Z",
          "revision": 1,
          "state": {
            "status": "queued"
          }
        },
        "bodyKind": "json"
      },
      "captures": {
