{
  "$jsonSchema": {
    "bsonType": "object",
    "additionalProperties": false,
    "required": [
      "_id",
      "format_version",
      "agent_id",
      "work",
      "result"
    ],
    "properties": {
      "_id": {
        "bsonType": "string",
        "minLength": 82,
        "maxLength": 82,
        "pattern": "^capacity-recovery:[a-f0-9]{64}$"
      },
      "format_version": {
        "bsonType": "long",
        "enum": [
          2
        ]
      },
      "agent_id": {
        "bsonType": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "work": {
        "bsonType": "object",
        "additionalProperties": false,
        "required": [
          "format_version",
          "request",
          "target",
          "phase",
          "revision",
          "attempts",
          "next_fence",
          "lease",
          "ready_at",
          "completed_at"
        ],
        "properties": {
          "format_version": {
            "bsonType": "int",
            "enum": [
              1
            ]
          },
          "request": {
            "bsonType": "object",
            "additionalProperties": false,
            "required": [
              "agent_id",
              "creation_key",
              "creation_fingerprint",
              "failure_seq",
              "requested_at"
            ],
            "properties": {
              "agent_id": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "creation_key": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "creation_fingerprint": {
                "bsonType": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              "failure_seq": {
                "bsonType": "long",
                "minimum": 2,
                "maximum": 9007199254740991
              },
              "requested_at": {
                "bsonType": "string",
                "minLength": 20,
                "maxLength": 20,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              }
            }
          },
          "target": {
            "bsonType": "object",
            "additionalProperties": false,
            "required": [
              "agent_id",
              "creation_key",
              "creation_fingerprint",
              "conversation_id",
              "conversation_generation",
              "runtime",
              "home_identity",
              "original_open",
              "active_turn",
              "input_sha256"
            ],
            "properties": {
              "agent_id": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "creation_key": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "creation_fingerprint": {
                "bsonType": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              "conversation_id": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "conversation_generation": {
                "bsonType": "long",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "runtime": {
                "bsonType": "object",
                "additionalProperties": false,
                "required": [
                  "runtime_id",
                  "runtime_version",
                  "bound_at"
                ],
                "properties": {
                  "boot_id": {
                    "bsonType": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  "runtime_id": {
                    "bsonType": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  },
                  "runtime_version": {
                    "bsonType": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  },
                  "provision_generation": {
                    "bsonType": "long",
                    "minimum": 1,
                    "maximum": 9223372036854775807
                  },
                  "bound_at": {
                    "bsonType": "string",
                    "minLength": 20,
                    "maxLength": 20,
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  }
                }
              },
              "home_identity": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "original_open": {
                "bsonType": "object",
                "additionalProperties": false,
                "required": [
                  "step",
                  "operation_id",
                  "request_sha256",
                  "completed_at"
                ],
                "properties": {
                  "step": {
                    "bsonType": "string",
                    "enum": [
                      "open_conversation"
                    ]
                  },
                  "operation_id": {
                    "bsonType": "string",
                    "minLength": 1,
                    "maxLength": 545
                  },
                  "request_sha256": {
                    "bsonType": "string",
                    "minLength": 64,
                    "maxLength": 64,
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "completed_at": {
                    "bsonType": "string",
                    "minLength": 20,
                    "maxLength": 20,
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  }
                }
              },
              "active_turn": {
                "oneOf": [
                  {
                    "bsonType": "null"
                  },
                  {
                    "bsonType": "long",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                ]
              },
              "input_sha256": {
                "bsonType": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "phase": {
            "bsonType": "string",
            "enum": [
              "admitted",
              "attaching",
              "completed",
              "superseded"
            ]
          },
          "revision": {
            "bsonType": "long",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "attempts": {
            "bsonType": "long",
            "minimum": 0,
            "maximum": 4294967295
          },
          "next_fence": {
            "bsonType": "long",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "lease": {
            "oneOf": [
              {
                "bsonType": "null"
              },
              {
                "bsonType": "object",
                "additionalProperties": false,
                "required": [
                  "holder",
                  "fence",
                  "expires_at"
                ],
                "properties": {
                  "holder": {
                    "bsonType": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "fence": {
                    "bsonType": "long",
                    "minimum": 1,
                    "maximum": 9223372036854775807
                  },
                  "expires_at": {
                    "bsonType": "string",
                    "minLength": 20,
                    "maxLength": 20,
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  }
                }
              }
            ]
          },
          "ready_at": {
            "bsonType": "string",
            "minLength": 20,
            "maxLength": 20,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "completed_at": {
            "oneOf": [
              {
                "bsonType": "null"
              },
              {
                "bsonType": "string",
                "minLength": 20,
                "maxLength": 20,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              }
            ]
          }
        }
      },
      "result": {
        "bsonType": "object",
        "additionalProperties": false,
        "required": [
          "agent_digest",
          "logs_digest",
          "agent_revision",
          "through_seq",
          "published_at"
        ],
        "properties": {
          "agent_digest": {
            "bsonType": "binData"
          },
          "logs_digest": {
            "bsonType": "binData"
          },
          "agent_revision": {
            "bsonType": "long",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "through_seq": {
            "bsonType": "long",
            "minimum": 2,
            "maximum": 9007199254740991
          },
          "published_at": {
            "bsonType": "string",
            "minLength": 20,
            "maxLength": 20,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        }
      }
    }
  },
  "$expr": {
    "$and": [
      {
        "$lte": [
          {
            "$bsonSize": "$$ROOT"
          },
          32768
        ]
      },
      {
        "$eq": [
          "$agent_id",
          "$work.request.agent_id"
        ]
      },
      {
        "$eq": [
          "$work.target.agent_id",
          "$work.request.agent_id"
        ]
      },
      {
        "$eq": [
          "$work.target.creation_key",
          "$work.request.creation_key"
        ]
      },
      {
        "$eq": [
          "$work.target.creation_fingerprint",
          "$work.request.creation_fingerprint"
        ]
      },
      {
        "$gte": [
          "$result.through_seq",
          "$work.request.failure_seq"
        ]
      },
      {
        "$eq": [
          {
            "$eq": [
              "$work.phase",
              "attaching"
            ]
          },
          {
            "$ne": [
              "$work.lease",
              null
            ]
          }
        ]
      },
      {
        "$eq": [
          {
            "$eq": [
              "$work.phase",
              "completed"
            ]
          },
          {
            "$ne": [
              "$work.completed_at",
              null
            ]
          }
        ]
      },
      {
        "$or": [
          {
            "$ne": [
              "$work.phase",
              "completed"
            ]
          },
          {
            "$eq": [
              "$work.completed_at",
              "$result.published_at"
            ]
          }
        ]
      },
      {
        "$or": [
          {
            "$eq": [
              "$work.lease",
              null
            ]
          },
          {
            "$lt": [
              "$work.lease.fence",
              "$work.next_fence"
            ]
          }
        ]
      },
      {
        "$or": [
          {
            "$eq": [
              "$work.target.active_turn",
              null
            ]
          },
          {
            "$lte": [
              "$work.target.active_turn",
              "$work.request.failure_seq"
            ]
          }
        ]
      }
    ]
  }
}
