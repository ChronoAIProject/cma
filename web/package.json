{
  "name": "cma-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:mechanics": "playwright test --config e2e/mechanics.config.ts",
    "e2e:typecheck": "tsc --project e2e/tsconfig.json",
    "check:styles": "node scripts/computed-styles.mjs",
    "check:css": "node scripts/css-collisions.mjs"
  },
  "dependencies": {
    "gpt-tokenizer": "4.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.184.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "postcss": "8.5.26",
    "prettier": "^3.6.0",
    "puppeteer-core": "^25.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "4.1.11"
  }
}
