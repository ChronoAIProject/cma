{
  "name": "cma-web",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "vite --mode fixtures",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:approval-contract": "vitest run --mode approval-contract",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:mechanics": "playwright test --config e2e/mechanics.config.ts",
    "e2e:typecheck": "tsc --project e2e/tsconfig.json",
    "e2e:owner-timing": "node e2e/owner-timing/run.mjs",
    "e2e:owner-timing:test": "node --test e2e/owner-timing/run.test.mjs",
    "check:styles": "node scripts/computed-styles.mjs",
    "check:css": "node scripts/css-collisions.mjs"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-details": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@xyflow/react": "12.12.0",
    "dompurify": "3.4.17",
    "eventsource-parser": "4.1.0",
    "gpt-tokenizer": "4.0.3",
    "linkifyjs": "4.3.3",
    "marked": "17.0.6",
    "mermaid": "12.2.0",
    "micromark-extension-cjk-friendly-util": "3.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-cjk-friendly": "2.3.4",
    "remark-gfm": "^4.0.1",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.184.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "postcss": "8.5.26",
    "prettier": "^3.6.0",
    "puppeteer-core": "25.13.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.7",
    "vitest": "4.1.12"
  }
}
