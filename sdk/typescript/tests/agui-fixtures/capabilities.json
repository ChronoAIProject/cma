{
  "protocol": "ag-ui",
  "transports": [
    "sse"
  ],
  "events": {
    "RUN_STARTED": true,
    "RUN_FINISHED": true,
    "RUN_ERROR": true,
    "TEXT_MESSAGE_START": true,
    "TEXT_MESSAGE_CONTENT": true,
    "TEXT_MESSAGE_END": true,
    "TOOL_CALL_START": true,
    "TOOL_CALL_ARGS": true,
    "TOOL_CALL_END": true,
    "TOOL_CALL_RESULT": true,
    "REASONING_MESSAGE_CONTENT": true,
    "REASONING_START": false,
    "REASONING_END": false,
    "REASONING_MESSAGE_START": false,
    "REASONING_MESSAGE_END": false,
    "REASONING_MESSAGE_CHUNK": false,
    "REASONING_ENCRYPTED_VALUE": false,
    "THINKING_START": false,
    "THINKING_END": false,
    "THINKING_TEXT_MESSAGE_START": false,
    "THINKING_TEXT_MESSAGE_CONTENT": false,
    "THINKING_TEXT_MESSAGE_END": false,
    "STATE_SNAPSHOT": false,
    "STATE_DELTA": true
  },
  "features": {
    "transport": {
      "streaming": true,
      "resumable": true,
      "websocket": false,
      "pushNotifications": false
    },
    "state": {
      "snapshots": false,
      "deltas": true,
      "persistentState": true
    },
    "humanInTheLoop": {
      "supported": true,
      "approvals": true,
      "interrupts": true,
      "approveWithEdits": false,
      "interventions": false
    },
    "execution": {
      "codeExecution": true,
      "sandboxed": true
    },
    "custom": {
      "cma:terminal": false,
      "cma:usage": true,
      "cma:changePlane": false,
      "cma:planeChangeObserved": true,
      "cma:resources": true,
      "cma:chat": {
        "enabled": false
      },
      "cma:liveFrames": true,
      "cma:trigger": {
        "preview": true,
        "launchSnapshot": true,
        "progressReplay": true,
        "diffReview": true,
        "mutations": false
      }
    }
  },
  "conformsTo": [
    "https://spec.chrono-ai.fun/cma/1.0/conf/agui-core",
    "https://spec.chrono-ai.fun/cma/1.0/conf/approvals",
    "https://spec.chrono-ai.fun/cma/1.0/conf/agui-trigger-read"
  ]
}
