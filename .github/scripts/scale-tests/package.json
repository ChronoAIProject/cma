{
  "name": "cma-local-scale-tests",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test test/*.test.mjs && npm run test:python",
    "test:python": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s test -p '*_test.py'",
    "test:ha": "node --test test/ha-evidence.test.mjs test/contract.test.mjs test/scenarios.test.mjs test/replicas.test.mjs",
    "coverage": "node --experimental-test-coverage --test-coverage-include='lib/**' --test-coverage-include='scenarios/**' --test-coverage-lines=80 --test-coverage-functions=80 --test test/*.test.mjs",
    "lint": "eslint . --max-warnings=0 && node check.mjs",
    "run": "node run.mjs",
    "run:ha": "node run.mjs --scenario ha"
  },
  "devDependencies": { "eslint": "9.39.0", "@eslint/js": "9.39.0", "globals": "16.5.0" }
}
