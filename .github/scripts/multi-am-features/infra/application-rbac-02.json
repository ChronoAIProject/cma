{
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "Role",
  "metadata": {
    "name": "cma-native-am",
    "namespace": "cma-native-am"
  },
  "rules": [
    {
      "apiGroups": [
        "agents.x-k8s.io"
      ],
      "resources": [
        "sandboxes"
      ],
      "verbs": [
        "get",
        "list",
        "watch",
        "create",
        "patch",
        "delete"
      ]
    },
    {
      "apiGroups": [
        "extensions.agents.x-k8s.io"
      ],
      "resources": [
        "sandboxtemplates",
        "sandboxwarmpools",
        "sandboxclaims"
      ],
      "verbs": [
        "get",
        "list",
        "create",
        "patch",
        "delete"
      ]
    },
    {
      "apiGroups": [
        "sandbox.opensandbox.io"
      ],
      "resources": [
        "batchsandboxes"
      ],
      "verbs": [
        "get",
        "list",
        "delete"
      ]
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "persistentvolumeclaims"
      ],
      "verbs": [
        "get",
        "list",
        "create",
        "patch",
        "delete"
      ]
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "pods"
      ],
      "verbs": [
        "get",
        "list",
        "create",
        "delete"
      ]
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "pods/exec"
      ],
      "verbs": [
        "get",
        "create"
      ]
    },
    {
      "apiGroups": [
        "snapshot.storage.k8s.io"
      ],
      "resources": [
        "volumesnapshots"
      ],
      "verbs": [
        "get",
        "list",
        "create",
        "delete"
      ]
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "services",
        "events"
      ],
      "verbs": [
        "get",
        "list",
        "watch"
      ]
    }
  ]
}
