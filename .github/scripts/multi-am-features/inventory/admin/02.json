    "id": "ADM-012",
    "role": "admin",
    "feature": "Admin usage completed report: 30d",
    "entry_point": "Account menu → Operations; /operations → Sandboxes & usage → Time range",
    "steps": [
      "Select 30d; for custom enter a valid local-time interval no longer than 30 days.",
      "Apply filters and measure until the requested range has committed totals and a populated or valid empty table.",
      "Repeat three times, retaining request/report IDs and AM attribution; count cold and warm observations separately."
    ],
    "expected_result": "The requested authorized range completes, allocation totals are finite and correctly scoped, and no preview/pending/error view is reported as completed.",
    "writes": true,
    "api": [
