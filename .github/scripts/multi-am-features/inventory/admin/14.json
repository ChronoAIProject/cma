  {
    "id": "ADM-081",
    "role": "admin",
    "feature": "Cross-owner Send, interrupt, second Send and approvals as control operator",
    "entry_point": "Locally created other-owner Agent → conversation",
    "steps": [
      "Read fresh access with control_any_sandbox.",
      "Send, interrupt, send again and resolve one approval across AMs.",
      "Revoke authority between admission and effect and verify rejection/revalidation."
    ],
    "expected_result": "Interact/resolve_approval are enforced, output appears once, and a revoked connection or stale authority is never used for a send.",
    "writes": true,
    "api": [
