#!/usr/bin/env bash
set -euo pipefail
scale_root=$(cd "$(dirname "$0")/.." && pwd)
case "${1:-}" in
  get|describe|logs|top|apply|create|delete|scale|rollout|wait|port-forward|auth) ;;
  *) echo 'Refused unsupported kubectl command' >&2; exit 2 ;;
esac
for arg in "$@"; do
  case "$arg" in
    --context*|--kubeconfig*|--server*|--cluster*|--user*|--token*|--client-*|--password*|--certificate-authority*|--insecure-skip-tls-verify*|--tls-server-name*|--namespace*|--all-namespaces*|--raw*|--proxy-url*|--as*|exec|attach|cp)
      echo "Refused context/namespace override or pod access: $arg" >&2; exit 2 ;;
    # Permit only the short forms used by this bundle. Reject attached values
    # and combined shorthands, including -nother, -sURL, -A=true and -wnother.
    -o|-o=*|-f|-f=*|-l|-l=*|-) ;;
    --*) ;;
    -*) echo 'Refused unsupported short option' >&2; exit 2 ;;
  esac
done
scale_server=$(kubectl --kubeconfig "$scale_root/private/kubeconfig" --context kind-cma-scale config view --minify -o jsonpath='{.clusters[0].cluster.server}')
[[ "$scale_server" == 'https://127.0.0.1:16443' ]] || { echo 'Refused Kubernetes API outside the owned loopback endpoint' >&2; exit 2; }
exec kubectl --kubeconfig "$scale_root/private/kubeconfig" --context kind-cma-scale --namespace cma-scale "$@"
