{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "policy/v1",
      "kind": "PodDisruptionBudget",
      "metadata": {
        "name": "cma-agent-manager",
        "namespace": "cma-scale",
        "labels": {
          "app.kubernetes.io/name": "cma-agent-manager",
          "app.kubernetes.io/part-of": "cma"
        }
      },
      "spec": {
        "minAvailable": 1,
        "unhealthyPodEvictionPolicy": "AlwaysAllow",
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "cma-agent-manager"
          }
        }
      }
    },
    {
      "apiVersion": "policy/v1",
      "kind": "PodDisruptionBudget",
      "metadata": {
        "name": "cma-event-gateway",
        "namespace": "cma-scale",
        "labels": {
          "app.kubernetes.io/name": "cma-event-gateway",
          "app.kubernetes.io/part-of": "cma"
        }
      },
      "spec": {
        "minAvailable": 1,
        "unhealthyPodEvictionPolicy": "AlwaysAllow",
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "cma-event-gateway"
          }
        }
      }
    }
  ]
}
