{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "autoscaling/v2",
      "kind": "HorizontalPodAutoscaler",
      "metadata": {
        "name": "cma-agent-manager",
        "namespace": "cma-scale",
        "labels": {
          "app.kubernetes.io/name": "cma-agent-manager",
          "app.kubernetes.io/part-of": "cma"
        },
        "annotations": {
          "cma.chronoai.dev/local-cap": "M3 local 2-to-4-to-2; production manifests remain max5"
        }
      },
      "spec": {
        "scaleTargetRef": {
          "apiVersion": "apps/v1",
          "kind": "Deployment",
          "name": "cma-agent-manager"
        },
        "minReplicas": 2,
        "maxReplicas": 4,
        "metrics": [
          {
            "type": "Resource",
            "resource": {
              "name": "cpu",
              "target": {
                "type": "Utilization",
                "averageUtilization": 60
              }
            }
          }
        ],
        "behavior": {
          "scaleUp": {
            "stabilizationWindowSeconds": 0,
            "selectPolicy": "Max",
            "policies": [
              {
                "type": "Pods",
                "value": 2,
                "periodSeconds": 60
              },
              {
                "type": "Percent",
                "value": 100,
                "periodSeconds": 60
              }
            ]
          },
          "scaleDown": {
            "stabilizationWindowSeconds": 300,
            "selectPolicy": "Min",
            "policies": [
              {
                "type": "Pods",
                "value": 1,
                "periodSeconds": 120
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "autoscaling/v2",
      "kind": "HorizontalPodAutoscaler",
      "metadata": {
        "name": "cma-event-gateway",
        "namespace": "cma-scale",
        "labels": {
          "app.kubernetes.io/name": "cma-event-gateway",
          "app.kubernetes.io/part-of": "cma"
        },
        "annotations": {
          "cma.chronoai.dev/local-cap": "M3 local 2-to-4-to-2; production manifests remain max5"
        }
      },
      "spec": {
        "scaleTargetRef": {
          "apiVersion": "apps/v1",
          "kind": "Deployment",
          "name": "cma-event-gateway"
        },
        "minReplicas": 2,
        "maxReplicas": 4,
        "metrics": [
          {
            "type": "Resource",
            "resource": {
              "name": "cpu",
              "target": {
                "type": "Utilization",
                "averageUtilization": 200
              }
            }
          }
        ],
        "behavior": {
          "scaleUp": {
            "stabilizationWindowSeconds": 0,
            "selectPolicy": "Max",
            "policies": [
              {
                "type": "Pods",
                "value": 2,
                "periodSeconds": 60
              },
              {
                "type": "Percent",
                "value": 100,
                "periodSeconds": 60
              }
            ]
          },
          "scaleDown": {
            "stabilizationWindowSeconds": 300,
            "selectPolicy": "Min",
            "policies": [
              {
                "type": "Pods",
                "value": 1,
                "periodSeconds": 120
              }
            ]
          }
        }
      }
    }
  ]
}
