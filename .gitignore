# Rust
api/target/

# Node
web/node_modules
web/dist/
web/coverage/
web/e2e/.auth/
web/e2e/test-results/
web/e2e/playwright-report/

# Python bytecode is generated; it is never committed.
__pycache__/
*.pyc

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local env — never commit real values
.env
.env.*
!.env.example
.gstack/
# Agent tool scratch, including git worktrees. A root-level entry here would
# fail the repository-structure gate if it were ever committed.
.claude/

# Private deployment inputs and internal documentation stay outside GitHub.
/infra/
/docs/
/sdk/
*.tfstate
*.tfstate.*

# Temporary private checkout for the protected deployment job.
.github/.cd-private/
